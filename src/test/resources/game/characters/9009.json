{
  "schema": 1,
  "rules": [
    {
      "on": "TURN_START",
      "when": [
        {
          "type": "entity",
          "entity": "self",
          "jsno": {
            "is_ally": true
          }
        }
      ],
      "do": [
        {
          "op": "GAIN_ENERGY",
          "amount": 1,
          "target": "self"
        }
      ]
    }
  ]
}
